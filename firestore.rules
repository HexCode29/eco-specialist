rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Contact Messages Collection
    match /contactMessages/{document} {
      allow create: if true; // Allow anyone to create contact messages
      allow read, update, delete: if false; // Only admin can read/update/delete
    }
    
    // Quote Requests Collection
    match /quoteRequests/{document} {
      allow create: if true; // Allow anyone to create quote requests
      allow read, update, delete: if false; // Only admin can read/update/delete
    }
    
    // Grant Applications Collection
    match /grantApplications/{document} {
      allow create: if true; // Allow anyone to create grant applications
      allow read, update, delete: if false; // Only admin can read/update/delete
    }
    
    // Newsletter Subscribers Collection
    match /newsletterSubscribers/{document} {
      allow create: if true; // Allow anyone to subscribe to newsletter
      allow read, update, delete: if false; // Only admin can read/update/delete
    }
    
    // Admin Collection (for future admin panel)
    match /admin/{document} {
      allow read, write: if false; // Only authenticated admin users
    }
    
    // All other documents are denied by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
